[Unit]
Description=Journal to MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=systemd-journal
StateDirectory=lokimankeli
StateDirectoryMode=0700
LoadCredential=config.toml:/etc/lokimankeli.toml
# The TLS credentials below are optional. Uncomment those referenced by relative
# ca_file, cert_file, or key_file paths in config.toml.
# LoadCredential=ca.pem:/etc/lokimankeli/ca.pem
# LoadCredential=client.crt:/etc/lokimankeli/client.crt
# LoadCredential=client.key:/etc/lokimankeli/client.key
WorkingDirectory=%d
ExecStart=/usr/local/bin/lokimankeli --config config.toml
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=
LockPersonality=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
